{
  "name": "vite-plugin-git-meta",
  "version": "0.1.0",
  "description": "Vite plugin that injects git metadata (branch, tag, commit, dates) at build time, with an optional typed Vue 3 plugin.",
  "keywords": [
    "vite",
    "vite-plugin",
    "vue",
    "git",
    "version",
    "build-info"
  ],
  "license": "MIT",
  "author": "Sukaato",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CheeseGrinder/vite-plugin-git-meta.git"
  },
  "bugs": "https://github.com/CheeseGrinder/vite-plugin-git-meta/issues",
  "homepage": "https://github.com/CheeseGrinder/vite-plugin-git-meta#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "check:package": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "preview": "pkg-pr-new publish --bun --packageManager=bun --comment=update"
  },
  "peerDependencies": {
    "vite": ">=5.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "~24.12.2",
    "dprint": "^0.61.1",
    "oxlint": "^1.87.0",
    "pkg-pr-new": "^0.0.93",
    "publint": "^0.3.25",
    "typescript": "~6.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "vue": "^3.5.35"
  },
  "engines": {
    "node": ">=20"
  }
}
